# Copy to server/.env

# Leave empty for in-memory mode (no MongoDB required)
MONGO_URI=

PORT=5050
CLIENT_ORIGIN=http://localhost:5174

# --- Amazon Bedrock (AWS Builder mini challenge) ---
# 1) Create an IAM user/role with bedrock:InvokeModel + bedrock:Converse
# 2) In Bedrock console, enable model access for your chosen model
# 3) Fill these and restart the server
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Examples (enable the matching model in Bedrock Model access first):
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=
